                "maxLength": 10
              },
              "usePrefix": {
                "description": "Show the prefix instead of the name in lists.",
                "type": "boolean"
              },
              "billingName": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "billingEmail": {
                "anyOf": [
                  {
                    "type": "string",
