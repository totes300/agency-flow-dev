      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "save_projects",
    "title": "Create or update Agency Flow projects",
    "description": "Create or edit projects (admins). Create needs name, client, billingType and its terms: fixed — fixedFee, [estimates], [rates]; retainer — includedMinutes, monthlyFee, overageRate, startDate, [cycleLength], [rollover]; t_and_m — [rates]; non_billable — none. A term the type does not take is an error; client and billingType never change. Money is in the client's currency; durations are minutes or \"20h\". All-or-nothing; omitted fields stay, null clears. Example: {\"items\": [{\"name\": \"Arlow site\", \"client\": \"client:ARLO\", \"billingType\": \"retainer\", \"includedMinutes\": \"20h\", \"monthlyFee\": 2000, \"overageRate\": 95, \"startDate\": \"2026-11-01\"}]}",
    "inputSchema": {
      "type": "object",
      "properties": {
        "items": {
          "minItems": 1,
          "maxItems": 25,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "description": "Project to edit; omit to create.",
                "type": "string",
                "maxLength": 500
              },
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "client": {
                "type": "string",
                "maxLength": 500
              },
              "code": {
                "description": "Task key prefix (ARLO → ARLO-21), unique; default from the client. A change renames task keys (old ones keep working).",
                "type": "string",
                "maxLength": 10
              },
              "billingType": {
                "type": "string",
                "enum": [
                  "fixed",
                  "retainer",
                  "t_and_m",
                  "non_billable"
                ]
              },
              "fixedFee": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000
              },
              "includedMinutes": {
                "description": "Per month.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  {
                    "type": "string",
                    "maxLength": 20
                  }
                ]
              },
              "monthlyFee": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000
              },
              "overageRate": {
                "description": "Hourly, over the included time.",
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000
              },
              "startDate": {
                "description": "First day of the first period.",
                "type": "string",
                "format": "date"
              },
              "cycleLength": {
                "description": "Months per cycle (default 1).",
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "rollover": {
                "description": "Unused time rolls over within a 2+ month cycle.",
                "type": "boolean"
              },
              "retainerActive": {
                "description": "false pauses the retainer.",
                "type": "boolean"
              },
              "estimates": {
                "description": "Budget per category; replaces the list.",
                "maxItems": 100,
