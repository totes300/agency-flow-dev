  {
    "name": "save_plan",
    "title": "Plan work on the Agency Flow Planner",
    "description": "Schedule a task on the Planner (a bar: member × task × dates) or move and resize a bar. A task can have several bars. Unschedule with delete. Admins plan anyone's row, members their own. All-or-nothing; omitted fields stay, null clears. Example: {\"items\": [{\"task\": \"ARLO-21\", \"startDate\": \"2026-10-27\", \"endDate\": \"2026-10-29\"}]}",
    "inputSchema": {
      "type": "object",
      "properties": {
        "items": {
          "minItems": 1,
          "maxItems": 25,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "description": "Bar to move or resize (fetch include [\"plan\"]); omit for a new bar.",
                "type": "string",
                "maxLength": 500
              },
              "task": {
                "type": "string",
                "maxLength": 500
              },
              "member": {
                "description": "Whose row (default you).",
                "type": "string",
                "maxLength": 500
              },
              "startDate": {
                "type": "string",
                "format": "date"
              },
              "endDate": {
                "description": "Inclusive; default startDate.",
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": false
          }
        },
        "idempotencyKey": {
          "description": "Same key within 24 h replays the first result; reused for a different call: refused.",
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "items"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
